<Application x:Class="YtdlpDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YtdlpDesktop.Converters">
    <Application.Resources>
        <conv:InverseBooleanConverter x:Key="InversoBooleano" />
        <conv:BusyToButtonTextConverter x:Key="TextoBotonDescarga" />
        <conv:ErrorToBrushConverter x:Key="ColorEstado" />
        <conv:StringToVisibilityConverter x:Key="TextoAVisibilidad" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanoAVisibilidad" />
    </Application.Resources>
</Application>
