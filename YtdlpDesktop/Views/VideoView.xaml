<UserControl x:Class="YtdlpDesktop.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:YtdlpDesktop.Helpers">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="◆ " Foreground="#A855F7" FontSize="20"/>
                <TextBlock Text="Descargar video" FontSize="24" FontWeight="Bold" Foreground="White" />
            </StackPanel>
            <TextBlock Text="Pega el link, consulta las resoluciones disponibles y elige una."
                       Foreground="#9CA3AF" Margin="0,0,0,24" TextWrapping="Wrap" />

            <TextBlock Text="LINK DE YOUTUBE" FontSize="10" FontWeight="Bold" Foreground="#38E4B7" Margin="0,0,0,6" />
            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding EstaOcupado, Converter={StaticResource InversoBooleano}}" />

            <Button Content="CONSULTAR RESOLUCIONES" Command="{Binding ConsultarCommand}"
                    IsEnabled="{Binding EstaOcupado, Converter={StaticResource InversoBooleano}}"
                    Margin="0,16,0,16" Padding="10,10" Background="#1A1E26" Foreground="#38E4B7" BorderBrush="#4d38E4B7" BorderThickness="1" 
                    FontWeight="Bold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding TituloVideo}" Foreground="#A855F7" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding TituloVideo, Converter={StaticResource TextoAVisibilidad}}" />

                <ItemsControl ItemsSource="{Binding Formatos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,4,8,4" Padding="12,10" Background="#0b0d14" Foreground="White"
                                    HorizontalContentAlignment="Left" BorderBrush="#4dA855F7" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding DataContext.DescargarCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Etiqueta}" Foreground="#FFD700" FontWeight="Bold" Width="100" />
                                    <TextBlock Text="{Binding Detalle}" Foreground="#D1D5DB" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <ProgressBar Minimum="0" Maximum="100" helpers:ProgressBarSmoother.SmoothValue="{Binding Progreso}" Height="6" Margin="0,10,0,0" 
                         Visibility="{Binding EstaOcupado, Converter={StaticResource BooleanoAVisibilidad}}"
                         BorderBrush="#1f2937" BorderThickness="1" Background="#0b0d14">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#38E4B7" Offset="0"/>
                        <GradientStop Color="#A855F7" Offset="1"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>

            <TextBlock Text="{Binding MensajeEstado}"
                       Foreground="{Binding EsError, Converter={StaticResource ColorEstado}}"
                       Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

            <Button Content="📁 Abrir archivo descargado" Command="{Binding AbrirCarpetaCommand}"
                    Visibility="{Binding DescargaCompletada, Converter={StaticResource BooleanoAVisibilidad}}"
                    Background="#1f2937" Foreground="White" BorderBrush="#A855F7" BorderThickness="1"
                    Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left" Cursor="Hand" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
